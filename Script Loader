-- Clean up previous UI instances safely
local function cleanupExisting()
	for _, container in ipairs({ CoreGui, player:FindFirstChild("PlayerGui") }) do
		if container then
			local old = container:FindFirstChild("DarkMoonHub")
			if old then
				old:Destroy()
			end
		end
	end
end

