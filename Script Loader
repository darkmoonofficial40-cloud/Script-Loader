local currentMenu = nil
local tabButtons = {}
local isExecuting = false

local function setStatus(text, color)
	StatusLabel.Text = text
	StatusLabel.TextColor3 = color or Theme.TextSecondary
	StatusDot.BackgroundColor3 = color or Theme.Success
end

local function selectMenu(index)
	currentMenu = Menus[index]
	if not currentMenu then return end

	SelectedTitle.Text = currentMenu.Name
	SelectedDesc.Text = currentMenu.Description
	PillText.Text = currentMenu.Tag
	setStatus("Ready • " .. currentMenu.Name, Theme.TextSecondary)

	for i, btn in ipairs(tabButtons) do
		local active = (i == index)
		tween(btn, fastTween, {
			BackgroundColor3 = active and Theme.Accent or Theme.BgElevated,
			TextColor3 = active and Theme.TextPrimary or Theme.TextSecondary,
		})
	end
end

for i, item in ipairs(Menus) do
	local TabBtn = Instance.new("TextButton")
	TabBtn.Size = UDim2.new(1, 0, 0, 30)
	TabBtn.BackgroundColor3 = Theme.BgElevated
	TabBtn.Text = item.Name
	TabBtn.TextColor3 = Theme.TextSecondary
	TabBtn.Font = Enum.Font.GothamSemibold
	TabBtn.TextSize = 11
	TabBtn.TextTruncate = Enum.TextTruncate.AtEnd
	TabBtn.AutoButtonColor = false
	TabBtn.Parent = Sidebar
	addCorner(TabBtn, 6)

	TabBtn.MouseButton1Click:Connect(function()
		selectMenu(i)
	end)

	table.insert(tabButtons, TabBtn)
end

ExecuteBtn.MouseButton1Click:Connect(function()
	if not currentMenu or isExecuting then return end
	isExecuting = true

	tween(ExecuteBtn, fastTween, { Position = UDim2.new(0, 10, 1, -36) })

	local copied = copyDiscordInvite()
	setStatus(
		copied and ("Discord copied • Running " .. currentMenu.Name) or ("Running " .. currentMenu.Name),
		Theme.Warning
	)

	local success, err = pcall(currentMenu.Action)
	if success then
		setStatus("Done • Closing hub...", Theme.Success)
		task.wait(0.35)
		if ScreenGui and ScreenGui.Parent then
			ScreenGui:Destroy()
		end
	else
		isExecuting = false
		tween(ExecuteBtn, fastTween, { Position = UDim2.new(0, 10, 1, -38) })
		setStatus("Failed • Check F9", Theme.Danger)
		warn("[DARK MOON HUB] Error in " .. currentMenu.Name .. ": " .. tostring(err))
	end
end)

